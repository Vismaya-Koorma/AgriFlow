                "2. Practice 2-year crop rotation with non-solanaceous crops"
            ],
            "control_measures": [
                "1. Apply copper-based bactericide at early symptom onset",
                "2. Remove infected plant debris post-harvest"
            ],
            "cultural_practices": [
                "Avoid overhead sprinkler irrigation"
            ],
            "water_management": [
                "Use drip irrigation to keep foliage dry"
            ],
            "nutrient_management": [
                "Maintain balanced Nitrogen and Calcium levels"
            ],
            "severity_indicators": [
                "Mild: Leaf spots",
                "Severe: Fruit scabs and defoliation"
            ],
            "source": [
