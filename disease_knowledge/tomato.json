                "Cool (15-22\u00b0C) wet weather"
            ],
            "prevention": [
                "1. Plant resistant cultivars",
                "2. Destroy volunteer tomato plants"
            ],
            "control_measures": [
                "1. Apply Metalaxyl + Mancozeb prophylactic spray",
                "2. Destroy infected plants immediately"
            ],
            "cultural_practices": [
                "Maintain clean field margins"
            ],
            "water_management": [
                "Avoid evening irrigation"
            ],
            "nutrient_management": [
                "Balanced soil nutrition"
            ],
            "severity_indicators": [
                "Mild: Single leaf lesion",
                "Severe: Field-wide blighting"
            ],
            "source": [
