            ]
        },
        "early_blight": {
            "disease": "Tomato Early Blight",
            "scientific_name": "Alternaria solani",
            "symptoms": [
                "Concentric target-board ring spots on lower leaves",
                "Yellowing around spots",
                "Defoliation starting from lower foliage"
            ],
            "causes": [
                "Alternaria solani fungal pathogen",
                "Warm humid weather with frequent dew"
            ],
            "prevention": [
                "1. Space plants adequately for air circulation",
                "2. Mulch soil to prevent rain splash"
            ],
            "control_measures": [
                "1. Spray Mancozeb (0.2%) or Copper Oxychloride",
                "2. Remove lower infected leaves"
            ],
            "cultural_practices": [
                "Stake plants upright"
            ],
            "water_management": [
                "Irrigate at base of stem"
            ],
            "nutrient_management": [
                "Apply adequate Potassium to enhance resistance"
            ],
            "severity_indicators": [
                "Mild: Lower leaf spots",
                "Severe: Severe leaf drop"
            ],
            "source": [
                "ICAR - IIHR Bangalore",
                "Kerala Agricultural University"
            ]
        },
        "late_blight": {
            "disease": "Tomato Late Blight",
            "scientific_name": "Phytophthora infestans",
            "symptoms": [
                "Large dark water-soaked leaf lesions",
                "White fungal growth on lower leaf surface under high humidity",
                "Rapid stem rot and fruit decay"
            ],
            "causes": [
